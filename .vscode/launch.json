{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DocsetMCP (Web)",
            "type": "debugpy",
            "request": "launch",
            "program": ".venv/bin/fastmcp",
            "args": ["run", "-t", "streamable-http", "docsetmcp/main.py"],
            "console": "integratedTerminal",
            "env": {
                "DOCSET_PATH": "${input:DOCSET_PATH}",
            },
        }
    ],
    "inputs": [
        {
            "id": "DOCSET_PATH",
            "type": "promptString",
            "description": "docset directory",
        }
    ]
}